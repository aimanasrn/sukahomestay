# Leave these empty for the clearly labelled browser demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=

# Edge Function secrets ONLY; never prefix these with VITE_.
