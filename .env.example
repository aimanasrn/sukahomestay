# TURNSTILE_SECRET_KEY=
# ALLOWED_ORIGIN=https://your-domain.example

# Optional isolated PostgreSQL integration test database (never production).
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/postgres
